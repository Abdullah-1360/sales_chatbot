# Production Environment Variables
# Copy this file to .env.production and update with your actual values

# Backend API URL (replace with your actual backend domain)
VITE_API_URL=https://api.yourdomain.com

# WebSocket URL (usually same as API URL)
VITE_WS_URL=https://api.yourdomain.com

# Example for subdomain:
# VITE_API_URL=https://backend.yourdomain.com
# VITE_WS_URL=https://backend.yourdomain.com

# Example for IP address:
# VITE_API_URL=http://123.456.789.012:3000
# VITE_WS_URL=http://123.456.789.012:3000
