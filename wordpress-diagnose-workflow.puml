@startuml WordPress Diagnose Workflow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam roundcorner 10
skinparam packageStyle rectangle

title WordPress Database Diagnostic Workflow

start

:Receive Diagnose Request;
:Validate Input Parameters;
note right: domain (required), email, phone

if (Validation Failed?) then (yes)
  :Return 400 Bad Request;
  stop
endif

:Check Cache for Recent Results;
if (Cache Hit?) then (yes)
  :Return Cached Response;
  stop
endif

partition "Step A: Quick Guards (Optional)" {
  if (Skip Guards?) then (no)
    :Check WHMCS Service State;
    if (Service Active?) then (no)
      :Return 412 Service Invalid;
      note right: Expired/Terminated/Suspended services
      stop
    endif
    
    :Check DNS Resolution;
    if (DNS Valid?) then (no)
      :Return DNS Misconfigured;
      stop
    endif
  endif
}

partition "Step B: Parse wp-config.php" {
  :Get Username for Domain;
  note right: WHM API call to find cPanel username
  :Read wp-config.php File;
  if (File Found?) then (no)
    :Return 500 Config Read Failed;
    stop
  endif
  
  :Extract Database Credentials;
  note right: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
  
  if (Parse Successful?) then (no)
    :Return 500 Config Parse Error;
    stop
  endif
}

partition "Step B2: Database User Management" {
  :Check Database Exists;
  
  if (Database Found?) then (no)
    :Return 500 Database Not Found;
    note right: Escalate to technical support
    stop
  endif
  
  :Check User Exists & Has Privileges;
  
  if (User Valid?) then (no)
    :Generate Strong Password;
    note right: 16 chars, mixed case, numbers, symbols
    :Generate Unique Username;
    :Create Database User;
    :Grant ALL Privileges;
    :Update wp-config.php;
    note right: Write new credentials to file
    :Update Final Config;
  endif
}

partition "Step C1: MySQL Host Management (Parallel)" {
  :Get Cached Local Machine IP;
  note right: IP cached at server startup (110.93.226.228)
  
  fork
    :Resolve Server IP from cPanel Host;
    note right: DNS lookup for server IP
  fork again
    :Add Local Machine IP to MySQL Hosts;
    note right: cPanel MySQL remote access
  end fork
  
  if (Host Management Successful?) then (yes)
    :Schedule Cleanup (5 minutes);
    :Use Server IP for Connection;
  else (no)
    :Use Fallback Server IP;
  endif
}

partition "Step C: MySQL Connection Test" {
  :Test MySQL Connection;
  note right: Using server IP and updated credentials
  
  if (Connection Successful?) then (yes)
    :Connection Success;
  else (no)
    :Connection Failed;
  endif
}

if (Connection Successful?) then (yes)
  :Compile Success Results;
  :Format Response;
  :Return 200 OK;
  note right
  {
    "success": true,
    "status": "MYSQL_CONNECTION_SUCCESS",
    "result": {
      "connectionStatus": "success",
      "databaseHost": "localhost",
      "serviceStatus": "active",
      "credentialsUpdated": true
    },
    "duration": "5-8s (optimized)"
  }
  end note
  stop
endif

partition "Step D: Error Analysis" {
  :Map MySQL Error to Root Cause;
  note right
  ACCESS_DENIED → authentication
  UNKNOWN_DATABASE → database_missing
  CONNECTION_REFUSED → service_down
  ETIMEDOUT → network/firewall
  HOST_NOT_FOUND → dns_failure
  TABLE_CORRUPT → corruption
  TOO_MANY_CONNECTIONS → resource_exhaustion
  end note
}

partition "Step E: Remediation (Optional)" {
  if (Remediation Enabled?) then (yes)
    if (Root Cause = ACCESS_DENIED?) then (yes)
      :Repair User Privileges;
    elseif (Root Cause = UNKNOWN_DATABASE?) then (yes)
      :Create Missing Database;
    elseif (Root Cause = CONNECTION_REFUSED?) then (yes)
      if (Approve Service Restart?) then (yes)
        :Restart MySQL Service;
      else (no)
        :Service Restart Requires Approval;
      endif
    elseif (Root Cause = TABLE_CORRUPT?) then (yes)
      if (Approve Table Repair?) then (yes)
        :Repair Corrupted Tables;
      else (no)
        :Table Repair Requires Approval;
      endif
    elseif (Root Cause = TOO_MANY_CONNECTIONS?) then (yes)
      if (Approve Kill Connections?) then (yes)
        :Kill Idle Connections;
      else (no)
        :Connection Kill Requires Approval;
      endif
    endif
    
    :Perform Remediation Actions;
    
    if (Remediation Successful?) then (yes)
      :Re-test MySQL Connection;
      if (Post-Remediation Success?) then (yes)
        :Return 200 OK (Remediated);
        note right: Connection restored after remediation
        stop
      endif
    endif
  endif
}

partition "Step F: Final Error Response" {
  :Set Technical Escalation;
  :Add Error Analysis;
  :Add Recommendations;
  :Format Error Response;
  :Return 500 MySQL Connection Failed;
  note right
  {
    "success": false,
    "escalation": {
      "type": "technical",
      "reason": "MYSQL_CONNECTION_FAILED"
    },
    "errorAnalysis": {...},
    "recommendations": [...]
  }
  end note
}

stop

@enduml