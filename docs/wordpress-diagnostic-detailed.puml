@startuml WordPress Diagnostic Detailed Workflow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam roundcorner 5

title WordPress Database Diagnostic Tool - Detailed Workflow

actor User
participant "Diagnostic Manager" as DM
participant "Guard Step" as GS
participant "Parser Step" as PS
participant "Database User Management" as DUM
participant "MySQL Step" as MS
participant "Error Mapping Step" as EMS
participant "cPanel Client" as CP
participant "MySQL Client" as MC

User -> DM: diagnoseWordPressDatabase(params)
activate DM

== Step A: Quick Guards ==
DM -> GS: Quick validation checks
activate GS

alt Client ID provided
  GS -> GS: checkWhmcsServiceState()
  alt Service inactive
    GS --> DM: Escalate to Billing
    DM --> User: ESCALATE_BILLING
    deactivate GS
    deactivate DM
  end
end

GS -> GS: checkDnsResolution()
alt DNS resolution failed
  GS --> DM: Escalate User Notification
  DM --> User: DNS_MISCONFIGURED
  deactivate GS
  deactivate DM
end

GS --> DM: Guards passed
deactivate GS

== Step B: Parse wp-config.php ==
DM -> PS: extractDatabaseConfig()
activate PS

PS -> CP: readWpConfig('public_html', 'wp-config.php')
activate CP
CP --> PS: File content
deactivate CP

PS -> PS: Parse DB constants\n(DB_HOST, DB_NAME, DB_USER, DB_PASSWORD)
alt Parse failed
  PS --> DM: CONFIG_READ_FAILED
  DM --> User: Technical escalation
  deactivate PS
  deactivate DM
end

PS --> DM: Database configuration
deactivate PS

DM -> MS: validateLocalhostRequirement()
activate MS
alt Host not localhost
  MS --> DM: NON_LOCALHOST_HOST
  DM --> User: Configuration error
  deactivate MS
  deactivate DM
end
MS --> DM: Localhost validated
deactivate MS

== Step B2: Database User Management ==
DM -> DUM: manageDatabaseUser()
activate DUM

DUM -> DUM: checkDatabaseAndUser()
DUM -> CP: List databases and users
activate CP
CP --> DUM: Database/user status
deactivate CP

alt Database not found
  DUM --> DM: DATABASE_NOT_FOUND
  DM --> User: Technical escalation
  deactivate DUM
  deactivate DM
end

alt Configuration already valid
  DUM --> DM: No action needed
else User not in database
  DUM -> DUM: generateUniqueUsername()\n(Format: cpanel_user_wpXXXX)
  DUM -> DUM: generateStrongPassword()
  
  DUM -> CP: checkMySQLUserExists()
  activate CP
  CP --> DUM: User existence status
  deactivate CP
  
  alt User doesn't exist
    DUM -> CP: createMySQLUser()
    activate CP
    CP -> CP: JSON API v3 call\nMySQL/create_user
    alt Creation failed
      CP --> DUM: Creation failed
      DUM --> DM: User creation failed
      DM --> User: Technical escalation
      deactivate CP
      deactivate DUM
      deactivate DM
    end
    CP --> DUM: User created
    deactivate CP
  end
  
  DUM -> CP: assignUserToDatabase()
  activate CP
  CP -> CP: JSON API v3 call\nMySQL/set_privileges_on_database
  alt Assignment failed
    CP --> DUM: Assignment failed
    DUM --> DM: Assignment failed
    DM --> User: Technical escalation
    deactivate CP
    deactivate DUM
    deactivate DM
  end
  CP --> DUM: Privileges assigned
  deactivate CP
  
  DUM -> CP: updateWpConfigCredentials()
  activate CP
  CP -> CP: UAPI call\nFileman/save_file_content
  alt Update failed
    CP --> DUM: Update failed
    DUM --> DM: wp-config update failed
    DM --> User: Technical escalation
    deactivate CP
    deactivate DUM
    deactivate DM
  end
  CP --> DUM: wp-config updated
  deactivate CP
end

DUM --> DM: User management complete\n(with updated credentials)
deactivate DUM

== Step C: MySQL Connection Test ==
DM -> MS: testMySQLConnection()
activate MS

MS -> MC: validateLocalhostRequirement()
activate MC
MC --> MS: Validation result
deactivate MC

MS -> MC: testConnectionPromise()
activate MC
MC -> MC: Create mysql2/promise connection
MC -> MC: Execute test query
alt Connection failed
  MC --> MS: Connection error with details
else Connection successful
  MC --> MS: Connection success
end
deactivate MC

MS --> DM: Connection test result
deactivate MS

== Step D: Error Mapping & Analysis ==
DM -> EMS: mapMySQLError()
activate EMS

alt Connection failed
  EMS -> EMS: Map error codes to diagnoses
  note right
    Error Code Mapping:
    - ER_ACCESS_DENIED_ERROR (1045) → AUTH_FAILURE
    - ER_DBACCESS_DENIED_ERROR (1044) → DATABASE_MISSING/PERMISSION_MISSING
    - ER_BAD_DB_ERROR (1049) → DATABASE_MISSING
    - ECONNREFUSED → CONNECTION_REFUSED
    - ETIMEDOUT → CONNECTION_TIMEOUT
    - ENOTFOUND → INVALID_HOST
  end note
  
  EMS -> EMS: Generate user-friendly message
  EMS -> EMS: Provide recommendations
  EMS --> DM: Error analysis with recommendations
  DM --> User: MYSQL_CONNECTION_FAILED
  deactivate EMS
  deactivate DM
end

EMS --> DM: Success analysis
deactivate EMS

== Success Path ==
DM -> DM: generateSimplifiedSummary()
DM -> DM: Calculate duration
DM --> User: Diagnostic success result

deactivate DM

@enduml