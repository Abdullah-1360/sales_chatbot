@startuml Database User Management Flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam roundcorner 10

title Database User Management Subprocess

start

:Receive Database Configuration;
note right
  Input:
  - Database name
  - Current username
  - Current password
  - cPanel client
end note

:Initialize Result Object;

:Check Database and User Status;

if (Check Failed?) then (yes)
  :Return "CHECK_FAILED";
  stop
endif

if (Database Not Found?) then (yes)
  :Return "DATABASE_NOT_FOUND";
  note right: Database must be created manually
  stop
endif

if (Configuration Already Valid?) then (yes)
  :Return "No action needed";
  stop
endif

:Extract cPanel Username Prefix;
note right: Format: "cpanel_user_"

:Generate Unique Username;
note right
  Format: cpanel_user_wpXXXX
  - Respects 16-char MySQL limit
  - Uses timestamp + random number
end note

:Generate Strong Password;
note right
  - 16 characters
  - Mixed case, numbers, symbols
end note

:Check if Generated User Already Exists;

if (User Exists?) then (yes)
  :Skip User Creation;
  :Mark as "User already exists";
else (no)
  :Create MySQL User via cPanel JSON API v3;
  
  if (Creation Successful?) then (no)
    :Log Creation Error;
    :Return "User creation failed";
    stop
  endif
  
  :Log User Created Successfully;
endif

:Assign User Privileges to Database;
note right: Grant ALL PRIVILEGES

if (Assignment Successful?) then (no)
  :Log Assignment Error;
  :Return "Assignment failed";
  stop
endif

:Log Privileges Assigned Successfully;

:Update wp-config.php with New Credentials;

partition "wp-config.php Update Process" {
  if (Existing Content Provided?) then (yes)
    :Use Existing Content;
  else (no)
    :Read wp-config.php from cPanel;
  endif
  
  :Replace DB_USER constant;
  :Replace DB_PASSWORD constant;
  
  :Write Updated Content to File;
  
  if (Write Successful?) then (no)
    :Log Write Error;
    :Return "wp-config update failed";
    stop
  endif
  
  :Perform Verification (Optional);
  note right
    - Read file back
    - Check for new credentials
    - Log verification status
    - Don't fail on verification issues
  end note
}

:Update Final Credentials in Result;

:Log Management Completed Successfully;

:Return Success Result;
note right
  Output:
  - New username
  - New password
  - Action log
  - Success status
end note

stop

@enduml