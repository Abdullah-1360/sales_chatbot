@startuml WordPress Diagnostic Overview
!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam shadowing false
skinparam roundcorner 15
skinparam packageStyle rectangle

title WordPress Database Diagnostic Tool - High Level Overview

start

:Start Diagnostic;

partition "**Step A: Quick Guards**" #LightBlue {
  :Check Service Status;
  :Check DNS Resolution;
  
  if (Guards Pass?) then (no)
    if (Service Issue?) then (yes)
      :Escalate to **Billing**;
      stop
    else (DNS Issue)
      :Escalate to **User**;
      stop
    endif
  endif
}

partition "**Step B: Configuration**" #LightGreen {
  :Read wp-config.php;
  :Parse Database Settings;
  
  if (Config Valid?) then (no)
    :Escalate **Technical**\n(Config Read Failed);
    stop
  endif
  
  :Validate Localhost Only;
  
  if (Localhost?) then (no)
    :Escalate **Configuration Error**\n(Remote DB Not Supported);
    stop
  endif
}

partition "**Step B2: User Management**" #LightYellow {
  :Check Database & User Status;
  
  if (Database Exists?) then (no)
    :Escalate **Technical**\n(Database Missing);
    stop
  endif
  
  if (User Configured?) then (no)
    :Create New MySQL User;
    :Assign Database Privileges;
    :Update wp-config.php;
    
    if (User Management Success?) then (no)
      :Escalate **Technical**\n(User Creation Failed);
      stop
    endif
  endif
}

partition "**Step C: Connection Test**" #LightCoral {
  :Test MySQL Connection;
  :Use Updated Credentials;
}

partition "**Step D: Error Analysis**" #LightPink {
  :Analyze Connection Result;
  
  if (Connection Success?) then (no)
    :Map Error Codes;
    :Generate Recommendations;
    :Escalate **Technical**\n(MySQL Connection Failed);
    stop
  endif
}

:Generate Success Summary;
:Return Diagnostic Results;

stop

legend right
  |= Escalation Type |= Destination |
  | Billing | WHMCS/Billing System |
  | User | Customer Notification |
  | Technical | Support Team |
  | Configuration Error | User Education |
endlegend

note bottom
  **Key Features:**
  • Localhost-only MySQL support
  • Automatic user creation and management
  • Comprehensive error mapping
  • Multiple escalation paths
  • Real-time wp-config.php updates
end note

@enduml